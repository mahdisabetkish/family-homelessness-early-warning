# Raw and intermediate data are downloaded and rebuilt by the pipeline, so
# they are not tracked. `make data` restores them from gov.uk.
data/raw/
data/interim/
data/processed/

# Everything under outputs/ is generated. The figures the slides embed are
# the exception and are committed so the deck builds from a fresh clone.
outputs/models/
outputs/tables/*.csv

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# LaTeX
slides/*.aux
slides/*.fdb_latexmk
slides/*.fls
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
slides/*.synctex.gz

# OS
.DS_Store

